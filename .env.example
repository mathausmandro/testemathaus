# Para o Supabase local: com `npx supabase start` rodando, `node scripts/setup-local.mjs` cria o .env.local.
# Aqui ficam só os NOMES. Nunca coloque valores neste arquivo.
# Publicas (podem ir ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor e Edge Functions. Nunca com prefixo NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Somente servidor e banco. Valor pendente (dominio de e-mail da empresa).
ALLOWED_EMAIL_DOMAIN=

# --- Login (tarefa 012). Somente servidor. Detalhes em docs/auth-microsoft.md ---
# true quando o provedor Microsoft estiver configurado no Supabase Auth (habilita o botao).
AUTH_MICROSOFT_ENABLED=
# true so na maquina local: formulario de e-mail e senha para os usuarios de teste do seed.
# Ignorado se o Supabase nao for local ou se VERCEL_ENV/APP_ENV indicar producao.
AUTH_LOCAL_PASSWORD_LOGIN=
# URL publica do site (ex.: endereco da Vercel). Opcional; sem ela usa a origem da requisicao.
SITE_URL=
# production em producao (desliga o login local mesmo fora da Vercel).
APP_ENV=

# --- Lidas pela CLI do Supabase (supabase/config.toml), nao pelo app. Valores vem da TI. ---
SUPABASE_AUTH_EXTERNAL_AZURE_ENABLED=
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
SUPABASE_AUTH_EXTERNAL_AZURE_URL=
SUPABASE_AUTH_EXTERNAL_AZURE_REDIRECT_URI=
