{
    "name": "plataforma-ensaios",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "npm run build && playwright test",
        "test:perf": "node tests/perf/run-lighthouse.mjs",
        "verify": "node scripts/verify.mjs",
        "test:security": "secretlint \"**/*\" && npm audit --audit-level=high && vitest run tests/security",
        "gen:types": "supabase gen types typescript --local --schema public > src/lib/data/database.types.ts"
    },
    "dependencies": {
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.118.0",
        "next": "16.4.3",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "server-only": "^0.0.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
        "@tailwindcss/turbopack": "^4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^24.19.2",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9",
        "eslint-config-next": "16.4.3",
        "jsdom": "^30.1.3",
        "libpg-query": "^17.8.1",
        "secretlint": "^13.1.0",
        "supabase": "^2.122.0",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^5.0.5",
        "yaml": "^2.9.1"
    }
}
